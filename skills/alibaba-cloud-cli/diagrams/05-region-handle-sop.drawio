                <mxCell id="16" value="批量查询示例:&#xa;REGIONS=$(aliyun ecs DescribeRegions \&#xa;  --output json | jq -r &#39;.Regions.Region[].RegionId&#39;)&#xa;for REGION in $REGIONS; do&#xa;  echo &quot;=== Region: $REGION ===&quot;&#xa;  aliyun &lt;product&gt; &lt;api&gt; --RegionId &quot;$REGION&quot;&#xa;done" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;align=left;spacingLeft=5" vertex="1" parent="1">
